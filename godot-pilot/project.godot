; Engine configuration file.
; Promise Path - Non-Destructive Godot 4 Mobile Validation Pilot

config_version=5

[application]

config/name="Promise Path Godot Pilot"
run/main_scene="res://scenes/overworld_prologue.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

CampaignState="*res://scripts/campaign_state.gd"
SoundManager="*res://scripts/sound_manager.gd"
SceneTransition="*res://scripts/scene_transition.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
